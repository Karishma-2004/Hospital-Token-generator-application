# ---------------------------------------------------------------
# Copy this file to backend/.env and fill in YOUR values.
# backend/.env is ignored by git. Never put real passwords in this example file.
# ---------------------------------------------------------------

# --- Django -----------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email (Gmail SMTP). Use a Google "app password", not your normal password ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER= 'skkarishma902@gmail.com'
EMAIL_HOST_PASSWORD="uixp vgxs gpht dqcr"
DEFAULT_FROM_EMAIL= 'skkarishma902@gmail.com'

# --- Login security -------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
LOGIN_RATE_LIMIT=30/min

# --- Sprint 7: notifications --------------------------------------
NOTIFY_ASYNC=True
# console = only writes the SMS text to the server log (good for development)
# twilio  = sends real SMS (fill in the three TWILIO_ values)
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Sprint 7: payments -------------------------------------------
# mock     = demo gateway, no money moves (development only)
# razorpay = real payments (fill in both keys; required when DJANGO_DEBUG=False)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_TpeVYSm4neYA6i
RAZORPAY_KEY_SECRET=HKZ2KIjGpCCpDWWIoVqaEOzV

